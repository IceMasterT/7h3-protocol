{
  "name": "@7h3/protocol-cf",
  "version": "0.5.0",
  "private": true,
  "description": "7h3 Protocol — Cloudflare Workers gateway and middleware",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "setup": "npx tsx scripts/cf-setup.ts",
    "keys:load": "npx tsx scripts/kv-load-keys.ts",
    "secrets:set": "wrangler secret put GATEWAY_PRIVATE_KEY",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@7h3/protocol": "file:.."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "@types/node": "^26.1.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
