{
  "name": "@7h3/protocol-mcp",
  "version": "0.6.2",
  "description": "MCP server for @7h3/protocol \u2014 install into Claude to generate 7h3 secrets, keypairs, server boilerplate, and framework scaffolds",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "p7h3-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke-test-package.mjs"
  },
  "dependencies": {
    "@7h3/protocol": ">=0.5.0 <1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/IceMasterT/7h3-protocol.git",
    "directory": "mcp-server"
  },
  "overrides": {
    "qs": "^6.16.0",
    "fast-uri": "^3.1.6"
  }
}
